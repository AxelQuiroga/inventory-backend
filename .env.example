# Copiar a .env y completar. La app valida estas variables al boot (envSchema,
# src/config/env.ts): si JWT_SECRET falta o es débil, DATABASE_URL es inválida,
# etc., el proceso NO arranca (fail-fast).

# development | test | production
NODE_ENV=development

# Puerto HTTP del backend
PORT=3000

# Mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# PostgreSQL (Drizzle). Ej: postgresql://user:pass@localhost:5432/inventory_system
DATABASE_URL=

# Orígenes permitidos para CORS, separados por coma (sin espacios).
# El default cubre vite dev (5173) y el e2e de Playwright (4310).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4310,http://127.0.0.1:4310

# Rate limit del login (por IP, ventana 15 min). Activado por defecto; en las
# suites e2e se desactiva desde test-e2e-env.ts porque ejecutan muchos logins.
RATE_LIMIT_ENABLED=true

# Intentos de login permitidos por IP dentro de la ventana de 15 minutos.
RATE_LIMIT_MAX=10